@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<a class="btn btn-success btn-sm" asp-area="" asp-page="/Create">
    <i class="fas fa-plus"></i> Agregar registro
</a>

<table id="records" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Registro[0].Cantidad)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var registro in Model.Registro)
        {
            <tr class="list-row">
                <td>@Html.DisplayFor(modelItem => registro.Fecha)</td>
                <td>@Html.DisplayFor(modelItem => registro.Cantidad)</td>
                <td>
                    <a class="btn btn-danger btn-sm" asp-page="./Delete" asp-route-id="@registro.Id">
                        <i class="fas fa-trash-alt"></i> Borrar
                    </a>
                    <a class="btn btn-warning btn-sm" asp-page="./Update" asp-route-id="@registro.Id">
                        <i class="fas fa-edit"></i> Actualizar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

