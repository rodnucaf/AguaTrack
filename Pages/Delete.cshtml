@page
@model AguaTrack.Pages.DeleteModel
@{
}

<h3>¿Estás seguro de eliminar este registro?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Agua.Fecha)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Agua.Fecha)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Agua.Cantidad)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Agua.Cantidad)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Agua.Id" />
        <div class="form-group mb-3">
            <input type="submit" value="Eliminar" class="btn btn-danger " />
        </div>
        <br />
        <a class="btn btn-secondary btn-sm" asp-page="./Index"><i class="fas fa-arrow-left"></i> Volver</a>
    </form>
</div>



